{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Default-off sidecar schema linking static validation cell/phase labels to an existing raw wrench/state measurement without replacing that raw record.",
  "properties": {
    "schema_version": {"const": "STATIC_VALIDATION_LABEL_SCHEMA_V1"},
    "record_id": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "cell_id": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "session_id": {"minLength": 1, "type": "string"},
    "protocol_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "pose_id": {"minLength": 1, "type": "string"},
    "direction_id": {"minLength": 1, "type": "string"},
    "load_level_id": {"minLength": 1, "type": "string"},
    "repeat_id": {"minimum": 1, "type": "integer"},
    "phase": {"enum": ["PRE", "LOAD", "POST"]},
    "phase_sample_index": {"minimum": 0, "type": "integer"},
    "raw_measurement_source": {"minLength": 1, "type": "string"},
    "raw_measurement_id": {"minLength": 1, "type": "string"},
    "query_start_s": {"type": ["number", "null"]},
    "query_end_s": {"type": ["number", "null"]},
    "query_midpoint_s": {"type": ["number", "null"]},
    "query_latency_ms": {"minimum": 0, "type": ["number", "null"]},
    "fx_raw_n": {"type": ["number", "null"]},
    "fy_raw_n": {"type": ["number", "null"]},
    "fz_raw_n": {"type": ["number", "null"]},
    "raw_force_frame": {"type": ["string", "null"]},
    "state_host_time_s": {"type": ["number", "null"]},
    "state_sequence_id": {"type": ["integer", "null"]},
    "robot_state_valid": {"type": ["boolean", "null"]},
    "robot_state_invalid_reason": {"type": ["string", "null"]},
    "tcp_x_m": {"type": ["number", "null"]},
    "tcp_y_m": {"type": ["number", "null"]},
    "tcp_z_m": {"type": ["number", "null"]},
    "tcp_rx_rad": {"type": ["number", "null"]},
    "tcp_ry_rad": {"type": ["number", "null"]},
    "tcp_rz_rad": {"type": ["number", "null"]},
    "q1_rad": {"type": ["number", "null"]},
    "q2_rad": {"type": ["number", "null"]},
    "q3_rad": {"type": ["number", "null"]},
    "q4_rad": {"type": ["number", "null"]},
    "q5_rad": {"type": ["number", "null"]},
    "q6_rad": {"type": ["number", "null"]},
    "robot_operation_state": {"type": ["string", "null"]},
    "robot_model": {"type": ["string", "null"]},
    "robot_serial_number": {"type": ["string", "null"]},
    "controller_version": {"type": ["string", "null"]},
    "active_tool_name": {"type": ["string", "null"]},
    "active_workobject_name": {"type": ["string", "null"]},
    "active_hmi_tool_workobject_verified": {"type": ["boolean", "null"]},
    "tcp_translation_m_json": {"type": ["string", "null"]},
    "tcp_rpy_rad_json": {"type": ["string", "null"]},
    "payload_mass_kg": {"type": ["number", "null"]},
    "payload_cog_m_json": {"type": ["string", "null"]},
    "payload_inertia_kg_m2_json": {"type": ["string", "null"]},
    "sdk_available_tool_names_json": {"type": ["string", "null"]},
    "sdk_available_workobject_names_json": {"type": ["string", "null"]},
    "valid": {"type": "boolean"},
    "status": {"enum": ["VALID", "INVALID"]},
    "invalid_reason": {"type": "string"}
  },
  "required": [
    "schema_version",
    "record_id",
    "cell_id",
    "session_id",
    "protocol_sha256",
    "pose_id",
    "direction_id",
    "load_level_id",
    "repeat_id",
    "phase",
    "phase_sample_index",
    "raw_measurement_source",
    "raw_measurement_id",
    "query_start_s",
    "query_end_s",
    "query_midpoint_s",
    "query_latency_ms",
    "fx_raw_n",
    "fy_raw_n",
    "fz_raw_n",
    "raw_force_frame",
    "state_host_time_s",
    "state_sequence_id",
    "robot_state_valid",
    "robot_state_invalid_reason",
    "tcp_x_m",
    "tcp_y_m",
    "tcp_z_m",
    "tcp_rx_rad",
    "tcp_ry_rad",
    "tcp_rz_rad",
    "q1_rad",
    "q2_rad",
    "q3_rad",
    "q4_rad",
    "q5_rad",
    "q6_rad",
    "robot_operation_state",
    "robot_model",
    "robot_serial_number",
    "controller_version",
    "active_tool_name",
    "active_workobject_name",
    "active_hmi_tool_workobject_verified",
    "tcp_translation_m_json",
    "tcp_rpy_rad_json",
    "payload_mass_kg",
    "payload_cog_m_json",
    "payload_inertia_kg_m2_json",
    "sdk_available_tool_names_json",
    "sdk_available_workobject_names_json",
    "valid",
    "status",
    "invalid_reason"
  ],
  "title": "Static Validation Label Record V1",
  "type": "object"
}
